(
    version: 6,
    entries: [
        (
            key: Primary,
            state: (
                // Monitor 0 (eDP) — 200px offset from monitor origin
                position: MonitorOffset((200, 200)),
                logical_width: 1000,
                logical_height: 700,
                target: Classified(${MONITOR_0_DEVICE_KEY}),
                mode: Windowed,
                app_name: "restore_window",
            )
        ),
        (
            key: Managed("window-1"),
            state: (
                // Secondary window on Monitor 1 (HDMI)
                position: MonitorOffset((200, 200)),
                logical_width: 1200,
                logical_height: 800,
                target: Classified(${MONITOR_1_DEVICE_KEY}),
                mode: Windowed,
                app_name: "restore_window",
            )
        ),
    ],
)
