(
    version: 6,
    entries: [
        (
            key: Primary,
            state: (
                // BorderlessFullscreen targeting Monitor 0 (eDP, scale 2)
                position: MonitorOffset((0, 0)),
                logical_width: ${MONITOR_0_WIDTH},
                logical_height: ${MONITOR_0_HEIGHT},
                target: Classified(${MONITOR_0_DEVICE_KEY}),
                mode: BorderlessFullscreen,
                app_name: "restore_window",
            )
        ),
    ],
)
