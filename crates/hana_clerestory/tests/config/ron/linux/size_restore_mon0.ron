(
    version: 6,
    entries: [
        (
            key: Primary,
            state: (
                // Wayland: position not available, only size is tested
                position: Unpositioned,
                logical_width: 1000,
                logical_height: 700,
                target: Classified(${MONITOR_0_DEVICE_KEY}),
                mode: Windowed,
                app_name: "restore_window",
            )
        ),
    ],
)
