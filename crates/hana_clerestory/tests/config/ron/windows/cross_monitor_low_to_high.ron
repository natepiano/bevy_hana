(
    version: 3,
    entries: [
        (
            key: Primary,
            state: (
                // Saved on the high-DPI monitor, launched from the low-DPI monitor.
                // Target monitor is chosen by scale ROLE, so it may be any index.
                // Tests CompensateSizeOnly (low->high) strategy.
                position: MonitorOffset((200, 200)),
                // Kept modest so the software (WARP) swapchain stays small through the cross-DPI
                // move (700x500 logical = 1400x1000 physical on the scale-2 high monitor).
                logical_width: 700,
                logical_height: 500,
                monitor_index: ${HIGH_SCALE_MONITOR_INDEX},
                mode: Windowed,
                app_name: "restore_window",
            )
        ),
    ],
)
